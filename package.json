{
  "name": "refract-ui",
  "version": "1.0.1",
  "description": "Themeable React component library — primitives, form controls, and Three.js device/carousel components.",
  "homepage": "https://storybook.parammehta.com",
  "repository": "https://github.com/parammehta/refract-ui.git",
  "author": "Param Mehta <param.mehta95@gmail.com>",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./model": {
      "types": "./dist/entries/model.d.ts",
      "import": "./dist/model.js",
      "require": "./dist/model.cjs"
    },
    "./carousel": {
      "types": "./dist/entries/carousel.d.ts",
      "import": "./dist/carousel.js",
      "require": "./dist/carousel.cjs"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./reset.css": "./dist/reset.css",
    "./media.css": "./dist/media.css",
    "./assets/*": "./dist/assets/*",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "framer-motion": "^7 || ^10 || ^11 || ^12",
    "react": "^18.3.1 || ^19",
    "react-dom": "^18.3.1 || ^19",
    "three": "^0.185",
    "three-stdlib": "^2"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "three-stdlib": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-docs": "^10.5.5",
    "@storybook/react-vite": "^10.5.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.43",
    "@types/react": "~18.3",
    "@types/react-dom": "~18.3",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.5",
    "framer-motion": "^7.10.3",
    "fs-extra": "^10.1.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.24",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^7.8.3",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "storybook": "^10.5.5",
    "stylelint": "^17.14.1",
    "stylelint-config-css-modules": "^4.6.0",
    "stylelint-config-standard": "^40.0.0",
    "three": "^0.185.1",
    "three-stdlib": "^2.36.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.7",
    "vite-plugin-dts": "^4.4.0",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "dev": "storybook dev -p 9009 -h localhost",
    "storybook": "storybook dev -p 9009 -h localhost",
    "build": "vite build && node scripts/copy-static-assets.cjs && node scripts/build-tokens-css.cjs && node scripts/verify-exports.cjs",
    "build:storybook": "storybook build -o build-storybook && node scripts/draco-storybook.cjs && node scripts/models-storybook.cjs",
    "lint": "eslint .",
    "stylelint": "stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:storybook": "aws s3 sync --delete --exclude '.DS_Store' build-storybook s3://parammehta-portfolio-storybook && node scripts/invalidate-cloudfront-storybook.cjs"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
